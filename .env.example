# --- Accés ---
# El primer administrador. Només es fa servir el primer cop, quan la base de
# dades és buida: després, les contrasenyes es canvien des del portal.
PORTAL_USUARI=admin@vproof.local
PORTAL_CONTRASENYA=canvia-aquesta-contrasenya

# Signatura de la galeta de sessió. Obligatori en producció: una cadena llarga i aleatòria
# (per exemple, la sortida de `openssl rand -base64 48`).
AUTH_SECRET=canvia-aixo-per-una-cadena-llarga-i-aleatoria

# --- Base de dades ---
# El fitxer SQLite. Al costat, a «fitxers/», hi van les fotos pujades.
# Per defecte, dades/vproof-crm.sqlite dins del directori del portal.
# SQLITE_RUTA=/app/dades/vproof-crm.sqlite

# --- ERP ---
# L'adreça de vprooferp. Encara no s'hi connecta: només surt a Configuració.
# VPROOFERP_URL=

# Rellotge de les tasques periòdiques (ara, situar els clients al mapa).
# Posa-ho a 0 en desenvolupament si no vols que el portal faci consultes de geocodificació.
# SINCRONITZACIO_AUTOMATICA=0

# Port on publica el contenidor (docker-compose.yml).
# CRM_PORT=3000
