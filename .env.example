# Accés al portal (per defecte admin / admin)
PORTAL_USUARI=admin
PORTAL_CONTRASENYA=admin

# --- Identitat ---
# Amb DIRECTUS_URL definida, el login del portal es comprova contra Directus i
# les credencials locals de dalt queden desactivades. La crida la fa sempre el
# servidor: el navegador no parla mai amb Directus.
DIRECTUS_URL=https://directus-140120684729.europe-west1.run.app
# Testimoni del compte de màquina (portal@example.com), amb permís de només
# lectura sobre les col·leccions del CRM. Es crea amb scripts/crm-acces.mjs.
DIRECTUS_TOKEN=

# Marge per a l'arrencada en fred de Cloud Run (per defecte 30000 ms).
# DIRECTUS_ESPERA_MS=30000

# Signatura de la galeta de sessió. Obligatori en producció.
AUTH_SECRET=canvia-aixo-per-una-cadena-llarga-i-aleatoria

# --- Credencials de FactuSol (API de DELSOL) ---
# L'única font: el portal no les desa enlloc. La pantalla de Configuració
# n'ensenya l'estat, permet provar la connexió i llegeix les taules en cru.
# api_ejercicio admet <year> per agafar l'any en curs.
api_url = https://api.sdelsol.com
api_fabricante =
api_cliente =
api_db =
api_ejercicio = <year>
api_password =

# Rellotge de les sincronitzacions programades. Posa-ho a 0 en desenvolupament
# si no vols que el portal local escrigui a Directus pel seu compte.
# SINCRONITZACIO_AUTOMATICA=0
